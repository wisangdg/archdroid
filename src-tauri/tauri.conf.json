{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DroidDeck",
  "mainBinaryName": "droiddeck",
  "version": "0.1.0",
  "identifier": "io.github.droiddeck",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DroidDeck",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Android emulator manager for Linux",
    "longDescription": "DroidDeck is an LDPlayer-style desktop front-end for Waydroid. It initializes the Android system image, starts and stops the engine, installs APKs, injects GApps and ARM translation (libhoudini), manages system properties, opens the shared folder and provides smart key mapping - all from a single window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
