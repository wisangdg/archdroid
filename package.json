{
  "name": "archdroid",
  "private": true,
  "version": "0.1.1",
  "description": "ArchDroid - Modern Android emulator manager for Linux, powered by Waydroid",
  "license": "MIT",
  "author": "Wisang Drillian Geni <gwisang45@gmail.com>",
  "homepage": "https://github.com/wisangdg/archdroid",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisangdg/archdroid.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,html,json}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,css,html,json}\"",
    "test:unit": "node --test src/lib/*.test.js",
    "test:component": "vitest run",
    "test:e2e": "node scripts/e2e/smoke-webdriver.js",
    "test": "node --test src/lib/*.test.js && vitest run",
    "test:all": "node --test src/lib/*.test.js && vitest run && node scripts/e2e/smoke-webdriver.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:bundles": "NO_STRIP=1 tauri build",
    "package:arch": "cd packaging/arch && makepkg -f",
    "release:stage": "./scripts/release/generate-release.sh",
    "release:verify": "./scripts/release/verify-release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
