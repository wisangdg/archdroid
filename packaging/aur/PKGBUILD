# Maintainer: Wisang Drillian Geni <gwisang45 at gmail dot com>
#
# AUR package for the signed release. Unlike packaging/arch/PKGBUILD (which
# packages a local build), this downloads the release .deb and checks it
# against SHA256SUMS, whose signature makepkg verifies with the release key.
# Bump pkgver and the .deb checksum each release (docs/RELEASE-AND-UPDATES.md).
pkgname=archdroid-bin
pkgver=0.1.6
pkgrel=1
pkgdesc="Desktop app for Waydroid: set up Android, install APKs, add Google Play and ARM support"
arch=('x86_64')
url="https://github.com/wisangdg/archdroid"
license=('MIT')
depends=('gtk3' 'webkit2gtk-4.1' 'libappindicator-gtk3' 'waydroid')
optdepends=(
    'android-tools: adb, for authoritative APK install/uninstall, Force stop and boot status'
    'squashfs-tools: GApps and ARM translation installers'
    'lzip: GApps and ARM translation installers'
    'git: GApps/ARM translation helper and Phantom keymapper'
)
provides=('archdroid')
conflicts=('archdroid')
_release="https://github.com/wisangdg/archdroid/releases/download/v${pkgver}"
source=("ArchDroid_${pkgver}_amd64.deb::${_release}/ArchDroid_${pkgver}_amd64.deb"
        "SHA256SUMS-${pkgver}::${_release}/SHA256SUMS"
        "SHA256SUMS-${pkgver}.asc::${_release}/SHA256SUMS.asc"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/wisangdg/archdroid/v${pkgver}/LICENSE")
sha256sums=('908643de03f1f3003cdc84b196a135f0d73a3294e452d11e550620073754a232'
            'SKIP'
            'SKIP'
            'dcbe9ac5226364598f45a3e18d9290f54d577800d6b48d4b5ffe91cc91f8d3fb')
# Release key, see docs/VERIFY-RELEASE.md and keys.openpgp.org.
validpgpkeys=('EB0290C2138FA472E18F020318F47067ACC5BBF9')
options=('!debug' '!strip')  # ship the signed binary byte for byte
noextract=("ArchDroid_${pkgver}_amd64.deb")

prepare() {
    # The signature covers SHA256SUMS; this ties the .deb to that signed list.
    grep " ArchDroid_${pkgver}_amd64.deb\$" "SHA256SUMS-${pkgver}" \
        | sha256sum -c -
}

package() {
    cd "${pkgdir}"
    bsdtar -xOf "${srcdir}/ArchDroid_${pkgver}_amd64.deb" 'data.tar.*' | bsdtar -xf -
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
